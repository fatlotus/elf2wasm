{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elf2wasm",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "",
    "DOCKER_HUB_MIRROR": "mirror.gcr.io"
  }
}
